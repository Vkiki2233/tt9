<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto" app:orderingFromXml="true">
	<Preference app:key="screen_chinese_user_words" app:fragment="io.github.sspanak.tt9.chinese.ChineseUserWordsScreen"
		app:title="@string/chinese_user_words_title" />
	<Preference app:key="import_chinese_pack" app:title="@string/chinese_pack_import_update" />
	<Preference app:key="install_chinese_pack" app:title="@string/chinese_pack_finish_install"
		app:summary="@string/chinese_pack_system_confirmation" />
	<!-- Loading an absent profile must not recreate its preferences. Save explicit changes only. -->
	<SwitchPreferenceCompat
		app:key="pref_chinese_candidate_compact"
		app:persistent="false"
		app:defaultValue="true"
		app:title="@string/pref_chinese_candidate_compact"
		app:summary="@string/pref_chinese_candidate_compact_summary" />
	<SwitchPreferenceCompat app:key="pref_chinese_number_select" app:persistent="false" app:defaultValue="true"
		app:title="@string/pref_chinese_number_select" app:summary="@string/pref_chinese_number_select_summary" />
	<SwitchPreferenceCompat app:key="pref_chinese_prefix_completion" app:persistent="false" app:defaultValue="true"
		app:title="@string/pref_chinese_prefix_completion" app:summary="@string/pref_chinese_prefix_completion_summary" />
	<SwitchPreferenceCompat app:key="pref_chinese_common_only" app:persistent="false" app:defaultValue="false"
		app:title="@string/pref_chinese_common_only" app:summary="@string/pref_chinese_common_only_summary" />
	<PreferenceCategory app:title="@string/pref_chinese_fuzzy">
		<SwitchPreferenceCompat app:key="pref_chinese_fuzzy_nl" app:persistent="false" app:title="n / l" />
		<SwitchPreferenceCompat app:key="pref_chinese_fuzzy_z_zh" app:persistent="false" app:title="z / zh" />
		<SwitchPreferenceCompat app:key="pref_chinese_fuzzy_c_ch" app:persistent="false" app:title="c / ch" />
		<SwitchPreferenceCompat app:key="pref_chinese_fuzzy_s_sh" app:persistent="false" app:title="s / sh" />
		<SwitchPreferenceCompat app:key="pref_chinese_fuzzy_en_eng" app:persistent="false" app:title="en / eng" />
		<SwitchPreferenceCompat app:key="pref_chinese_fuzzy_in_ing" app:persistent="false" app:title="in / ing" />
	</PreferenceCategory>
	<ListPreference
		app:key="pref_interface_language"
		app:persistent="false"
		app:defaultValue="auto"
		app:entries="@array/interface_language_entries"
		app:entryValues="@array/interface_language_values"
		app:title="@string/pref_interface_language"
		app:summary="@string/pref_interface_language_summary" />
</PreferenceScreen>
